    "preview": "npm --prefix frontend run preview --",
    "test:unit": "python -m unittest discover -s tests/unit -v",
    "test:browser": "node tests/browser/capture-and-ui.cjs"
  },
  "dependencies": {
    "railway": "^3.11.0"
  }
}
