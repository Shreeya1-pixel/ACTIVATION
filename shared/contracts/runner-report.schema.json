{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autostack:phase1:runner-report:1",
  "title": "Proposed runner report envelope; schema validity is NOT approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "owner_id", "runner_id", "artifact_sha256", "plan_sha256", "permissions_sha256", "input_sha256", "output_sha256", "runtime_sha256", "suite_sha256", "policy_version", "connector_version", "status", "issued_at", "expires_at", "checks", "signature_key_id", "signature"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "runner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_sha256": {"$ref": "#/$defs/hash"},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "permissions_sha256": {"$ref": "#/$defs/hash"},
    "input_sha256": {"$ref": "#/$defs/hash"},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "runtime_sha256": {"$ref": "#/$defs/hash"},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "connector_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["passed", "blocked", "failed", "cancelled"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "checks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["id", "result"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "result": {"enum": ["pass", "fail", "missing", "timeout"]}}}},
    "signature_key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signature": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"checks": {"items": {"properties": {"result": {"const": "pass"}}}}}}}],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
