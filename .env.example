# ─────────────────────────────────────────────────────────────────────────────
# AutoStack — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Service bearer token for the worker API.
# Auto-generated on first run and persisted to artifacts/spike/token.
# Set this only if you want to override the auto-generated token.
AUTOSTACK_TOKEN=

# AI provider: "mock" (default, offline) or "gemini" (real Gemini API)
AUTOSTACK_AI_PROVIDER=mock

# Required only when AUTOSTACK_AI_PROVIDER=gemini
# Get your key from: https://aistudio.google.com/app/apikey
AUTOSTACK_GEMINI_KEY=

# Optional: Gemini model (default gemini-2.5-flash)
# AUTOSTACK_GEMINI_MODEL=gemini-2.5-flash

# Optional: custom data directory (default: artifacts/spike)
# AUTOSTACK_DATA_DIR=artifacts/spike

# Optional: extra Ed25519 public keys (base64, comma-separated) of offices whose
# registry templates this office trusts.
# AUTOSTACK_TRUSTED_SIGNERS=

# ── Railway (backend service) ───────────────────────────────────────────────
# ALLOWED_ORIGINS=https://<your-frontend>.up.railway.app   (CORS, comma-separated)
# AUTOSTACK_DATA_DIR=/data                                   (mount a volume at /data)
# RAILWAY_RUN_UID=0                                          (lets the app write to the volume)

# ── Railway (frontend service, build-time) ──────────────────────────────────
# VITE_API_BASE=https://<your-backend>.up.railway.app
